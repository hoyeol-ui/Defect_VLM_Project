      {
        "para_index": 2,
        "text": "\u2160. \uc11c  \ub860",
        "style": "\ud0c0\uc774\ud2c0"
      },
      {
        "para_index": 3,
        "text": "\uae08\uc18d \ud45c\uba74\uc758 \uacb0\ud568 \uac80\uc0ac\ub294 \uc81c\ud488 \ud488\uc9c8\uacfc \uacf5\uc815 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\ub294 \uc791\uc5c5\uc774\ub2e4. \uc601\uc0c1 \uae30\ubc18 \uac1d\uccb4 \uac80\ucd9c\uae30\ub294 \uacb0\ud568\uc758 \uc885\ub958\uc640 \uc704\uce58\ub97c \ud568\uaed8 \uc608\uce21\ud560 \uc218 \uc788\uc9c0\ub9cc, \ud559\uc2b5\uc5d0 \uc0ac\uc6a9\ud560 \uc774\ubbf8\uc9c0\ub9c8\ub2e4 \uacbd\uacc4 \uc0c1\uc790\uc640 \ud074\ub798\uc2a4 \uc8fc\uc11d\uc774 \ud544\uc694\ud558\ub2e4. GC10-D",
        "style": "\ubc14\ud0d5\uae00"
      },
      {
        "para_index": 4,
        "text": "\uacf5\uac1c\ub41c \uc804\uccb4 \uc8fc\uc11d\uc744 \ud559\uc2b5\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uc870\uac74\uacfc \ub2ec\ub9ac, \uc2e4\uc81c \ub77c\ubca8 \uc608\uc0b0\uc774 \uc81c\ud55c\ub41c \uc0c1\ud669\uc5d0\uc11c\ub294 \uc5b4\ub5a4 \uc774\ubbf8\uc9c0\ub97c \uba3c\uc800 \uc8fc\uc11d\ud560 \uac83\uc778\uc9c0\uac00 \ubb38\uc81c\uac00 \ub41c\ub2e4. \ud480 \uae30\ubc18 \ub2a5\ub3d9\ud559\uc2b5\uc740 \ucd08\uae30 \ub77c\ubca8 \uc9d1\ud569\uc5d0\uc11c \ud559\uc2b5\ud55c \ubaa8\ub378 \ub610\ub294 \uc601\uc0c1 \ud45c\ud604\uc744 \uc774\uc6a9\ud574 \ubbf8",
        "style": "\ubc14\ud0d5\uae00"
      },
      {
        "para_index": 5,
        "text": "\ubcf8 \uc5f0\uad6c\ub294 \uace0\uc815\ub41c DINOv2 \uc601\uc0c1 \ud45c\ud604\uc5d0\uc11c farthest-first\ub85c \ud45c\ubcf8\uc744 \uc120\ud0dd\ud558\ub294 \ubc29\ubc95\uc774 \uae08\uc18d \ud45c\uba74 \uacb0\ud568 \uac80\ucd9c\uc758 \ub77c\ubca8 \ud6a8\uc728\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \uc8fc\ub294\uc9c0 \uac80\ud1a0\ud55c\ub2e4. \ube44\uad50 \ub300\uc0c1\uc740 Random\uacfc \uac80\ucd9c\uae30\uc758 \ud074\ub798\uc2a4 \uc810\uc218 En",
        "style": "\ubc14\ud0d5\uae00"
      },
      {
        "para_index": 6,
        "text": "\uc5f0\uad6c \uc9c8\ubb38\uc740 \ub450 \uac00\uc9c0\ub2e4. \uccab\uc9f8, \uac19\uc740 \uc608\uc0b0\uacfc \uac80\ucd9c\uae30\uc5d0\uc11c Frozen DINOv2 \uc120\ud0dd\uc758 \uc131\ub2a5\uace1\uc120\uacfc nAULC\uac00 \ub2e4\ub978 \uc804\ub7b5\uacfc \uc5b4\ub5bb\uac8c \ub2e4\ub978\uac00. \ub458\uc9f8, \uc81c\ud55c\ub41c \ub77c\ubca8\ub85c \ud655\ubcf4\ud55c \uc131\ub2a5\uc774 100% \uc9c0\ub3c4\ud559\uc2b5 \ucc38\uc870\uc640 \uc5bc\ub9c8\ub098 \ucc28\uc774\uac00 ",
        "style": "\ubc14\ud0d5\uae00"
      }
    ],
